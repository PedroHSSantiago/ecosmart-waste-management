{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PontosColetaListaSchema",
  "description": "Contrato JSON Schema para listagem de Pontos de Coleta",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "codigo_ponto",
      "tipo_residuo",
      "localizacao",
      "bairro",
      "capacidade_litros",
      "nivel_ocupacao_percentual",
      "status"
    ],
    "properties": {
      "codigo_ponto": { "type": "string" },
      "tipo_residuo": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      },
      "localizacao": {
        "type": "object",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "type": "string", "enum": ["Point"] },
          "coordinates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          }
        }
      },
      "bairro": { "type": "string" },
      "capacidade_litros": { "type": "integer", "minimum": 1 },
      "nivel_ocupacao_percentual": { "type": "integer", "minimum": 0, "maximum": 100 },
      "status": { "type": "string", "enum": ["ativo", "manutencao", "inativo"] }
    }
  }
}

