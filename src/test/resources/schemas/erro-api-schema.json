{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErroApiSchema",
  "description": "Contrato JSON Schema padronizado para respostas de erro HTTP (400, 404, 409)",
  "type": "object",
  "required": [
    "timestamp",
    "status",
    "erro",
    "mensagem",
    "caminho"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "enum": [400, 404, 409, 500]
    },
    "erro": {
      "type": "string",
      "minLength": 1
    },
    "mensagem": {
      "type": "string",
      "minLength": 1
    },
    "caminho": {
      "type": "string",
      "minLength": 1
    },
    "detalhes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

